# c6h6_dz: runs of bench/ncc_scaling/slurm_scaling.sh (written by mkruns.py)
# window 2 3
# ncc, SYMMETRY=ON: CCSDT, 3 iterations
ncc ncc_on_t1 c6h6.bohr cc-pvdz ON ON T 10 3 60 1 socket n
ncc ncc_on_t2 c6h6.bohr cc-pvdz ON ON T 10 3 60 2 socket n
ncc ncc_on_t4 c6h6.bohr cc-pvdz ON ON T 10 3 60 4 socket n
