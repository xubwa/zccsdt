zc zc_rhfq_t48 rhf c6h6.bohr cc-pvdz 6 2 1 70000 48 both
# runs of the start once more: drift of the node over the job
ncc ncc_on_again_t24 c6h6.bohr cc-pvdz ON ON T 10 3 60 24 socket n
ncc ncc_off_again_t24 c6h6.bohr cc-pvdz ON OFF T 10 3 60 24 socket n
zc zc_rhf_again_t24 rhf c6h6.bohr cc-pvdz 6 3 0 70000 24 socket
