ncc ncc_on_active_t24 c6h6.bohr cc-pvdz ON ON T 10 3 60 24 socket n ACTIVE
# ncc, SYMMETRY=ON: CCSDT(Q) (CC_CONV=3: (Q) needs converged iterations; 24 threads: CC_CONV=10, the energies)
ncc ncc_onq_t8 c6h6.bohr cc-pvdz ON ON Q 3 200 60 8 socket n
ncc ncc_onq_t16 c6h6.bohr cc-pvdz ON ON Q 3 200 60 16 socket n
ncc ncc_onq_t24 c6h6.bohr cc-pvdz ON ON Q 10 200 60 24 socket n
ncc ncc_onq_t48 c6h6.bohr cc-pvdz ON ON Q 3 200 60 48 both n
ncc ncc_onq_mem150_t48 c6h6.bohr cc-pvdz ON ON Q 3 200 150 48 both n
# ncc, SYMMETRY=OFF: CCSDT, 3 iterations
ncc ncc_off_t1 c6h6.bohr cc-pvdz ON OFF T 10 3 60 1 socket n
